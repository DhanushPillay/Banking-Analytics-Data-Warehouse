# Copy to .env and fill in. Never commit .env.
LOCAL_DB_PATH=data/banking_dw.duckdb

# Snowflake is used after the local build is verified.
# Use ACCOUNTADMIN or a write-capable loader role to upload.
# PBI_READER is read-only and is only for Power BI.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=PBI_WH
SNOWFLAKE_DATABASE=LOAN_DEFAULT_DW
SNOWFLAKE_SCHEMA=RAW
# envsitter: Programmatic access token. If set, it takes priority over password/MFA.
SNOWFLAKE_PAT=
# envsitter: duckdb (default local) or snowflake (hybrid: four analytics tables from Snowflake, artifacts stay local)
DATA_SOURCE=duckdb
